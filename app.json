{
  "expo": {
    "name": "Ma7fzty",
    "slug": "mahfazty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B82F6"
    },
    "ios": {
      "supportsTablet": true
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#3B82F6"
    },
    "android": {
      "package": "com.fadyehabamer.mahfazty",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B82F6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ma7fzty to access your camera to take receipt photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ma7fzty to access your photos to attach receipts."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Ma7fzty to use Face ID to unlock the app."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Ma7fzty to use the microphone to add expenses and income by voice.",
          "speechRecognitionPermission": "Allow Ma7fzty to recognize your speech to add expenses and income by voice.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9ae5b475-b702-47c9-b688-994dfe52f40e"
      }
    },
    "owner": "fadyehabamer"
  }
}
